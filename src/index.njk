{%- from "components/postInfo/macro.njk" import postInfo -%}

{#
  Grab the newest item in the Now collection and feed that date
  into the postInfo macro
#}

{% set isNowDate = collections.now.slice().reverse()[0].date %}
{% set latestPosts = collections.post.concat(collections.now) | sort(true, true, 'date') %}

<header class="splash">
  <h1>{{ title }}</h1>
  <nav class="home">
    <ul class="inline-list">
      <li><a href="/about">about</a></li>
      <li><a href="/blog">blog</a></li>
      <li><a href="/notes">notes</a></li>
      <li><a href="/now">now</a></li>
      <li><a href="/feed.xml">rss</a></li>
    </ul>
  </nav>
</header>

<p>Welcome to my website. The newest entries from my blog and my now page can be
found below, or you can read more in the links above.<p>

{% for post in latestPosts.slice(0, 3) %}
  {{ postInfo(post, isNowDate) }}
{% endfor %}

<p>Read more on <a href="/blog">my blog</a>.</p>
